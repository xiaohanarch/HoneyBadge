# GitHub Actions Secrets for E2E Tests
# ========================================
# Add these secrets to your GitHub repository:
# Settings → Secrets and variables → Actions
# ========================================

# Slack Notification (optional)
# Get your webhook URL from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Microsoft Teams Notification (optional)
# Get your webhook URL from Teams channel settings → Connectors
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/WEBHOOK/URL

# Email Notification (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@github.com
NOTIFY_EMAIL=your-email@example.com

# Docker Hub Credentials (if using private images)
DOCKERHUB_USERNAME=your-username
DOCKERHUB_TOKEN=your-token
