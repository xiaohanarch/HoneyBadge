# ===========================================================================
# HoneyBadge Environment Configuration
#
# Copy this file to .env and fill in the values for your deployment.
# All values shown are defaults for local development — override in
# production via environment variables or Kubernetes secrets.
#
# In production (ENV=production), insecure defaults are rejected at startup.
# ===========================================================================

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------
# Set to "production" to enable strict secret validation (rejects insecure
# defaults like "change-me-in-production", empty passwords, etc.)
ENV=development

# ---------------------------------------------------------------------------
# honeybadge-server (FastAPI :8090) — audit REST + sessions
# ---------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8090

# ---------------------------------------------------------------------------
# honeybadge-auth (FastAPI :8091) — login + Matrix account provisioning
# ---------------------------------------------------------------------------
# JWT secret — MUST be >= 32 chars in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Auth service JWT (separate from server JWT, same secret recommended)
JWT_EXPIRE_MINUTES=480

# ---------------------------------------------------------------------------
# NebulaGraph (knowledge graph database)
# ---------------------------------------------------------------------------
NEBULA_HOST=localhost
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=honeybadge

# ETL pipeline uses these alternative names (same values)
NEBULA_GRAPHD_HOST=localhost
NEBULA_GRAPHD_PORT=9669

# ---------------------------------------------------------------------------
# LLM service (via Higress gateway or direct provider)
# ---------------------------------------------------------------------------
# OpenAI-compatible endpoint. Workers reach the gateway via:
#   http://aigw-local.hiclaw.io:8080/v1
LLM_ENDPOINT=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=glm-4

# ---------------------------------------------------------------------------
# PostgreSQL (L5 audit log + chat sessions)
# ---------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=honeybadge
PG_PASSWORD=
PG_DATABASE=honeybadge

# ETL pipeline DSN (alternative connection string format)
# POSTGRES_DSN=postgresql://honeybadge:honeybadge123@localhost:5432/honeybadge_ods

# ---------------------------------------------------------------------------
# Redis (cache + token revocation + guardrail counters)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional: REDIS_URL takes precedence over host/port if set
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Milvus (vector DB — reserved for Phase 2, not yet used)
# ---------------------------------------------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ---------------------------------------------------------------------------
# HiClaw / Matrix integration (Phase 2+)
# ---------------------------------------------------------------------------
MATRIX_URL=
HICLAW_MANAGER_URL=

# Auth service — Matrix homeserver connection
TUWUNEL_URL=http://hiclaw-manager:6167
MATRIX_DOMAIN=matrix-local.hiclaw.io
MATRIX_HOMESERVER_PUBLIC=http://localhost:7167
MANAGER_USER_ID=@manager:matrix-local.hiclaw.io
MANAGER_MATRIX_PASSWORD=
HICLAW_REGISTRATION_TOKEN=
MATRIX_USER_SECRET=

# ---------------------------------------------------------------------------
# Google OAuth (optional — set GOOGLE_ENABLED=true to enable)
# ---------------------------------------------------------------------------
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SERVICE_URL=http://localhost:8091
DEFAULT_ROLE=analyst
STATE_SECRET=

# ---------------------------------------------------------------------------
# Observability — OpenTelemetry / Jaeger
# ---------------------------------------------------------------------------
# Set to enable OTLP export to Jaeger/Tempo/collector
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_VERSION=unknown

# ---------------------------------------------------------------------------
# Guardrails — hard constraints (tool-layer enforcement)
# ---------------------------------------------------------------------------
# L3 fail-closed: reject queries when user_context is missing/invalid.
# Set to "1" for dev/test bypass (NOT for production).
# HONEYBADGE_L3_FAIL_OPEN=0

# L4 numeric fidelity enforce: raise on summary number mismatch.
# Set to "1" to block hallucinated summaries (vs log-only by default).
# HONEYBADGE_L4_ENFORCE=0

# Max investigation rounds per task (default 5)
# HONEYBADGE_MAX_INVESTIGATION_ROUNDS=5

# ---------------------------------------------------------------------------
# Ontology / Prompts (domain routing)
# ---------------------------------------------------------------------------
# Override the ontology directory (default: prompts/ontology/)
# HONEYBADGE_ONTOLOGY_DIR=prompts/ontology

# Override the prompts directory (default: prompts/)
# HONEYBADGE_PROMPTS_DIR=prompts

# ---------------------------------------------------------------------------
# Externalized configuration files
# ---------------------------------------------------------------------------
# Point to a YAML file to override the built-in demo permission config.
# See deploy/config/permissions.yaml for the schema. If unset, the hardcoded
# defaults in src/honeybadge/permission_service/config.py are used.
# HONEYBADGE_PERMISSIONS_CONFIG=deploy/config/permissions.yaml

# Point to a YAML file to override the built-in demo user store.
# See deploy/config/users.yaml for the schema (plaintext passwords are
# hashed with bcrypt at load time). If unset, the hardcoded defaults in
# src/honeybadge/server/auth.py are used.
# HONEYBADGE_USERS_CONFIG=deploy/config/users.yaml

# ---------------------------------------------------------------------------
# Schema cache (Nebula MCP server)
# ---------------------------------------------------------------------------
# TTL for cached NebulaGraph schema (seconds, default 3600)
# SCHEMA_CACHE_TTL=3600
