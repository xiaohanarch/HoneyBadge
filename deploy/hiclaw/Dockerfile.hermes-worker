# deploy/hiclaw/Dockerfile.hermes-worker
# HoneyBadge Hermes Worker — extends agentteams-worker v1.2.2 with hermes-agent
# Built for analytics-worker only; graph-worker continues using the base image.

FROM higress-registry.cn-hangzhou.cr.aliyuncs.com/agentteams/agentteams-worker:v1.2.2

# Bootstrap pip, then install hermes-agent
# The base image has Python 3.12 but no pip
#
# mautrix / aiohttp-socks / aiohttp MUST be pinned to hermes-agent's internal
# feature pins (see its "platform.matrix" lazy-deps spec). Unpinned installs
# resolve to newer versions (e.g. mautrix 0.21.1 vs pin 0.21.0), the version
# check then fails at gateway boot, and the Matrix adapter is never created
# ("Platform 'matrix' is registered but adapter creation failed"). The worker
# then silently never receives Matrix task dispatches — every @analytics-worker
# task hangs forever with no result.json. hermes's own lazy pip-install can't
# self-heal because PEP 668 blocks it in this externally-managed environment.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-pip \
    && pip3 install --no-cache-dir --break-system-packages \
        hermes-agent \
        'mautrix[encryption]==0.21.0' \
        'aiohttp-socks==0.11.0' \
        'aiohttp==3.14.1' \
        asyncpg aiosqlite Markdown \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy hermes-specific entrypoint and config bridge
COPY hermes-worker-entrypoint.sh /opt/honeybadge/init/
COPY hermes-config-bridge.sh     /opt/honeybadge/init/
RUN chmod +x /opt/honeybadge/init/hermes-worker-entrypoint.sh \
             /opt/honeybadge/init/hermes-config-bridge.sh

# Skills directory on PYTHONPATH so `python3 -m common.mcp_client` resolves
# at runtime when skills are synced to /root/.hermes/skills/
ENV PYTHONPATH="${PYTHONPATH}:/root/.hermes/skills"

EXPOSE 8080
