# deploy/hiclaw/Dockerfile.worker
# HiClaw Worker (OpenClaw) container — applies to HiClaw v1.0.6
#
# UPGRADE CHECKLIST (see docs/patches/hiclaw-interface-contract-v1.md):
#   1. Verify Worker SKILL.md directory structure and instruction syntax
#   2. Verify mcporter MCP tool call conventions (tool names, transport)
#   3. Verify Worker sends x-honeybadge fields in result/error messages
#
# TODO: Replace image name with actual registry path once confirmed.
#       Expected format: registry.cn-hangzhou.aliyuncs.com/hiclaw/worker-openclaw:v1.0.6

FROM hiclaw/worker-openclaw:v1.0.6

# Copy skill definitions: SKILL.md + mcporter MCP configs
COPY skill/ /app/agent/skills/

EXPOSE 8080
