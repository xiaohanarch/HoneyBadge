# deploy/hiclaw/Dockerfile.worker
# HiClaw Worker (OpenClaw) container — applies to HiClaw v1.0.9
#
# UPGRADE CHECKLIST (see docs/patches/hiclaw-interface-contract-v1.md):
#   1. Verify Worker SKILL.md directory structure and instruction syntax
#   2. Verify mcporter MCP tool call conventions (tool names, transport)
#   3. Verify Worker sends x-honeybadge fields in result/error messages
#
# NOTE: In docker-compose (local dev), Workers pull ALL config (SOUL.md,
# AGENTS.md, openclaw.json) from MinIO at startup — no custom build needed.
# Worker registration is handled by deploy/hiclaw/init-workers.sh.
#
# This Dockerfile is kept as a reference for custom Worker image builds only
# (e.g. baking in skills for production deployments without MinIO dependency).

FROM higress-registry.cn-hangzhou.cr.aliyuncs.com/higress/hiclaw-worker:v1.0.9

# Workers get their config from MinIO at runtime.
# Nothing to COPY here for standard deployments.

EXPOSE 8080
