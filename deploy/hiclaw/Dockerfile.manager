# deploy/hiclaw/Dockerfile.manager
# Manager Docker image - Python base, installs from pyproject.toml

FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy source before install so pip install -e . can find the package
COPY pyproject.toml .
COPY src/ ./src/
RUN pip install --no-cache-dir -e .

# Environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Expose manager port
EXPOSE 8090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8090/api/health || exit 1

# Run manager
CMD ["python", "-m", "honeybadge.__main__", "manager"]
