# deploy/hiclaw/Dockerfile.manager
# Built on hiclaw-manager v1.1.0 (lightweight agent only — bundled infra moved to Dockerfile.embedded)
# HiClaw Manager container — applies to HiClaw v1.1.0
#
# UPGRADE CHECKLIST (see docs/patches/hiclaw-interface-contract-v1.md):
#   1. Verify x-honeybadge field passthrough (Manager must not strip x-honeybadge)
#   2. Verify Worker SKILL.md syntax is compatible with new version
#   3. Verify mcporter MCP call conventions unchanged
#   4. Verify Matrix DM room auto-accept behavior unchanged
#
# NOTE: In docker-compose (local dev), the Manager image is used directly
# without a custom build — worker configs are volume-mounted and registered
# via deploy/hiclaw/init-workers.sh.
#
# This Dockerfile is kept as a reference for custom Manager builds only.

FROM higress-registry.cn-hangzhou.cr.aliyuncs.com/higress/hiclaw-manager:v1.1.2

# Copy custom Manager agent configuration (SOUL.md, AGENTS.md)
# Mount path inside the Manager for agent identity files
COPY hiclaw/manager/agent/ /opt/hiclaw/agent/manager/

# No EXPOSE: Manager v1.1.0 is agent-only; Matrix bot is outbound-only.
