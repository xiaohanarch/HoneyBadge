CREATE EDGE CONTAINS_PAYMENT(org_id INT64, dept_id INT64);
CREATE EDGE SOLD_TO(order_date TIMESTAMP, org_id INT64, dept_id INT64);
CREATE EDGE HAS_SO_LINE(org_id INT64, dept_id INT64);
CREATE EDGE SELLS_ITEM(quantity DOUBLE, unit_price DOUBLE, org_id INT64, dept_id INT64);
CREATE EDGE HAS_SHIPMENT(org_id INT64, dept_id INT64);
CREATE EDGE HAS_SHIPMENT_LINE(org_id INT64, dept_id INT64);
CREATE EDGE HAS_AR_INVOICE(org_id INT64, dept_id INT64);
CREATE EDGE RECEIVED_FROM(org_id INT64, dept_id INT64);
CREATE EDGE APPLIES_TO(applied_amount DOUBLE, org_id INT64, dept_id INT64);
CREATE EDGE BOM_FOR(org_id INT64, dept_id INT64);
CREATE EDGE USES_COMPONENT(quantity_per DOUBLE, org_id INT64, dept_id INT64);
CREATE EDGE PARENT_ORG(org_id INT64, dept_id INT64);
CREATE EDGE BELONGS_TO_ORG(org_id INT64, dept_id INT64);
CREATE EDGE RECEIVED_AT(org_id INT64, dept_id INT64);
CREATE EDGE SHIPPED_FROM(org_id INT64, dept_id INT64);
CREATE EDGE ACCOUNTING_FOR(event_class STRING, org_id INT64, dept_id INT64);
CREATE EDGE POSTED_TO(org_id INT64, dept_id INT64);
CREATE EDGE HAS_JOURNAL_LINE(org_id INT64, dept_id INT64);
CREATE EDGE DISTRIBUTED_TO(org_id INT64, dept_id INT64);
CREATE EDGE APPROVED_BY(org_id INT64, dept_id INT64);
CREATE EDGE APPROVAL_FOR(doc_type STRING, org_id INT64, dept_id INT64);
CREATE EDGE CONTRACT_WITH(party_type STRING, org_id INT64, dept_id INT64);
CREATE EDGE UNDER_CONTRACT(org_id INT64, dept_id INT64);
