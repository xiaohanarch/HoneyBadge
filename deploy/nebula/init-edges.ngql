CREATE EDGE ORDERS_ITEM(quantity DOUBLE, unit_price DOUBLE, org_id INT64, dept_id INT64);
CREATE EDGE CONVERTS_TO_PO(conversion_date TIMESTAMP, org_id INT64, dept_id INT64);
CREATE EDGE HAS_PR_LINE(org_id INT64, dept_id INT64);
CREATE EDGE HAS_RECEIPT(org_id INT64, dept_id INT64);
CREATE EDGE HAS_RECEIPT_LINE(org_id INT64, dept_id INT64);
CREATE EDGE HAS_INVOICE(match_status STRING, match_date TIMESTAMP, org_id INT64, dept_id INT64);
CREATE EDGE ORDERED_BY(org_id INT64, dept_id INT64);
CREATE EDGE HAS_QUALIFICATION(org_id INT64, dept_id INT64);
CREATE EDGE SUPPLIES_ITEM(priority INT64, unit_price DOUBLE, lead_time_days INT64, status STRING, effective_from TIMESTAMP, effective_to TIMESTAMP, org_id INT64, dept_id INT64);
CREATE EDGE HAS_INVOICE_LINE(org_id INT64, dept_id INT64);
CREATE EDGE INVOICED_BY(org_id INT64, dept_id INT64);
