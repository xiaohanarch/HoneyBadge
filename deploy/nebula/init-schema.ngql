  posted_flag         BOOL DEFAULT false,
  org_id              INT64,
  dept_id             INT64,
  data_scope          STRING,
  created_at          TIMESTAMP,
  updated_at          TIMESTAMP,
  etl_batch_id        STRING,
  source_system       STRING,
  is_active           BOOL DEFAULT true
) COMMENT = '会计分配';

