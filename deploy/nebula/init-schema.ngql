-- Section 6: Approval Domain Tags
-- =============================================================================

-- 6.1 ApprovalRecord
CREATE TAG IF NOT EXISTS ApprovalRecord (
  approval_id         STRING NOT NULL,
  doc_type            STRING,
  doc_number          STRING,
  approval_action     STRING,
  approver            STRING,
  approval_date       TIMESTAMP,
  comments            STRING,
  approval_level      INT64,
  org_id              INT64,
