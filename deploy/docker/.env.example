# HoneyBadge local dev — Docker Compose environment template.
#
# Copy this file to `.env` (in the same directory) and fill in real values.
# `.env` is .gitignore'd and MUST stay out of version control. Never commit
# real keys / secrets here either — only placeholders.

# === LLM upstream =========================================================
# Production runs through Higress AI gateway. Local dev (WSL2) routes through
# the hiclaw-aigw-bypass nginx sidecar because Higress segfaults on WSL2.
# Any OpenAI-compatible endpoint works (BigModel, DashScope, MiniMax, Qwen, ...).
# Default below targets Zhipu BigModel (open.bigmodel.cn) — the upstream that
# docker-compose.yaml also defaults to. Switch LLM_ENDPOINT + LLM_UPSTREAM_HOST
# + LLM_UPSTREAM_PATH_PREFIX together when pointing at a different provider.
#
# MANAGER_LLM_MODEL: Manager + Workers (must be tool-calling capable).
#   glm-5.2 for production/manual testing. Do NOT use glm-4-flash here —
#   it cannot call skills (fast-query.sh) properly.
# LLM_MODEL: MCP servers only (nGQL generation). Can use glm-4-flash for
#   faster E2E tests.
LLM_ENDPOINT=https://open.bigmodel.cn
LLM_API_KEY=replace-with-your-llm-api-key
MANAGER_LLM_MODEL=glm-5.2
LLM_MODEL=glm-4-flash

# MCP servers reach the gateway inside the compose network via the bypass
# service alias. Workers use the same alias but build their own /v1 base URL.
MCP_LLM_ENDPOINT=http://aigw-local.hiclaw.io:8080

# Shared HMAC secret for honeybadge-server JWTs (dev only — change in prod).
JWT_SECRET=honeybadge-dev-secret-change-in-prod

# === HiClaw v1.1.0 manager (k8s-mode simulation) ==========================
# In production these come from a Kubernetes Secret injected by the operator.
# In compose we fake the same shape so manager-init-internal.sh stays uniform.
HICLAW_MANAGER_PASSWORD=replace-with-strong-password
HICLAW_MANAGER_GATEWAY_KEY=replace-with-32char-random-key

# === Dev gateway mode =====================================================
# nginx-bypass : use the hiclaw-aigw-bypass nginx sidecar (WSL2 workaround).
# higress      : use the embedded Higress instance (works on real Linux).
# Production k3s always uses real Higress; this var is only read by
# deploy/hiclaw scripts. Step 2c/2d of manager-init-internal.sh skip the
# Higress route/consumer wiring when this is set to "nginx-bypass".
HICLAW_DEV_GATEWAY=nginx-bypass

# Upstream LLM host + path prefix (used by hiclaw-aigw-bypass nginx for SNI,
# Host header, and /v1/ → upstream path rewrite). Must match LLM_ENDPOINT's
# hostname. BigModel needs /api/paas/v4 prefix; DashScope uses /v1 directly.
LLM_UPSTREAM_HOST=open.bigmodel.cn
LLM_UPSTREAM_PATH_PREFIX=/api/paas/v4

# === CORS =================================================================
# Comma-separated list of allowed browser origins. In production, specify
# explicit origins (never use "*"). Defaults to localhost:3000 and :5173.
HONEYBADGE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
