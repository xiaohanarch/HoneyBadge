# HoneyBadge Environment Configuration
# Copy to .env and customize values

# ============================================
# LLM Provider (Alibaba Bailian / DashScope)
# ============================================
LLM_PROVIDER=dashscope
LLM_ENDPOINT=https://coding.dashscope.aliyuncs.com/v1
LLM_API_KEY=sk-sp-264b0e52aba64ade970e13fb7a8adb10
LLM_MODEL=qwen3.5-plus
LLM_MODEL_NAME=qwen3.5-plus
COMPLEX_MODEL=qwen3.5-plus

# ============================================
# NebulaGraph
# ============================================
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=honeybadge

# ============================================
# PostgreSQL
# ============================================
PG_USER=honeybadge
PG_PASSWORD=honeybadge123
PG_DB=honeybadge_audit

# ============================================
# Redis
# ============================================
REDIS_PASSWORD=redis123

# ============================================
# MinIO (for ETL cold storage)
# ============================================
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123

# ============================================
# Higress Gateway
# ============================================
GATEWAY_ADMIN_PASSWORD=admin123

# ============================================
# Grafana
# ============================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# ============================================
# HiClaw Manager Admin (MinIO >= 8 chars required)
# ============================================
HICLAW_ADMIN_USER=admin
HICLAW_ADMIN_PASSWORD=admin1234
HICLAW_REGISTRATION_TOKEN=honeybadge-reg-token

# ============================================
# Matrix User Secret (Approach B)
# Used by honeybadge-auth to derive per-user Matrix passwords
# ============================================
MATRIX_USER_SECRET=hb-user-secret-dev

# ============================================
# Matrix (for HiClaw)
# ============================================
MATRIX_GATEWAY_PASSWORD=gateway-dev-pass
MATRIX_MANAGER_PASSWORD=manager-dev-pass
MATRIX_GRAPH_WORKER_PASSWORD=graph-worker-dev-pass
MATRIX_ANALYTICS_WORKER_PASSWORD=analytics-worker-dev-pass

# ============================================
# JWT Secret
# ============================================
JWT_SECRET=change-this-to-a-random-64-char-string-in-production

# ============================================
# Jaeger
# ============================================
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831

# ============================================
# Google OAuth2 (SSO)
# ============================================
GOOGLE_CLIENT_ID=908784766655-1dfafa8nhb6afv37g09c62mdpkctjvl5.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_ENABLED=true
AUTH_SERVICE_URL=http://localhost:8091
DEFAULT_ROLE=analyst
