LLM_ENDPOINT=https://coding.dashscope.aliyuncs.com
LLM_API_KEY=sk-sp-264b0e52aba64ade970e13fb7a8adb10
LLM_MODEL=qwen3-coder-plus
MCP_LLM_ENDPOINT=http://aigw-local.hiclaw.io:8080
JWT_SECRET=honeybadge-dev-secret-change-in-prod

# v1.1.0 manager k8s-mode credentials (simulating controller-injected secrets in Compose)
HICLAW_MANAGER_PASSWORD=hiclaw-manager-password-dev
HICLAW_MANAGER_GATEWAY_KEY=hiclaw-manager-gw-key-dev-32chars

# DEV GATEWAY MODE — selects how workers reach the LLM API in compose.
#   nginx-bypass : use the hiclaw-aigw-bypass service (Higress-broken-on-WSL2 workaround)
#   higress      : use real Higress in hiclaw-embedded (currently broken on WSL2; works on Linux)
# Production k3s always uses real Higress; this var is read only by deploy/hiclaw scripts.
HICLAW_DEV_GATEWAY=nginx-bypass

# Upstream LLM host (used by hiclaw-aigw-bypass nginx to set the SNI / Host header).
# Aliyun DashScope coding endpoint exposes both OpenAI-compatible (/v1/chat/completions)
# and Anthropic-compatible (/apps/anthropic) APIs. Workers use the OpenAI SDK, so the
# nginx-bypass forwards /v1/* directly to this host.
LLM_UPSTREAM_HOST=coding.dashscope.aliyuncs.com
